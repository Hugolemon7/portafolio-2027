---
import '../styles/global.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import LangHint from '../components/LangHint.astro';
import { t, settings, htmlLang, routes, type Lang } from '../i18n';
import { fontSetup } from '../lib/fonts';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** misma página en el otro idioma */
  alternate: string;
  image?: string;
}
const social = settings.social as { mode?: string; image?: string | null } | undefined;
// imagen para redes: la que subas en Keystatic → Imagen para redes, o la que se genera en cada publicación (scripts/og-image.mjs)
const { lang, title, description, alternate, image = social?.mode === 'custom' && social.image ? social.image : `/_og/og-${lang}.png` } = Astro.props;
const s = t(lang);
const pageTitle = title ? `${title} — ${settings.name}` : s.meta.title;
const desc = description ?? s.meta.description;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const altHref = new URL(alternate, site).href;
const other: Lang = lang === 'es' ? 'en' : 'es';
const accentVars = `--accent-light:${settings.accent.light};--accent-light-ink:${settings.accent.lightInk};--accent-dark:${settings.accent.dark};--accent-dark-ink:${settings.accent.darkInk}`;
// colores base de cada modo: solo se emiten los que cambian respecto a los originales de global.css
const SITE_ORIG = {
  light: { bg: '#eceef1', surface: '#e1e4e9', ink: '#1f2328', muted: '#444a53' },
  dark: { bg: '#121418', surface: '#1b1e24', ink: '#eceef2', muted: '#aeb3bd' },
} as const;
const mixHex = (a: string, b: string, k: number) => '#' + [1, 3, 5].map((i) => Math.round(parseInt(a.slice(i, i + 2), 16) * (1 - k) + parseInt(b.slice(i, i + 2), 16) * k).toString(16).padStart(2, '0')).join('');
const siteVars = (['light', 'dark'] as const).flatMap((m) => {
  const t = settings.accent.site?.[m];
  if (!t) return [];
  const o = SITE_ORIG[m];
  const out = (['bg', 'surface', 'ink', 'muted'] as const).filter((k) => t[k].toLowerCase() !== o[k]).map((k) => `--site-${m}-${k}:${t[k]}`);
  // campos de formulario: un paso más oscuro / claro que las tarjetas
  if (t.surface.toLowerCase() !== o.surface || t.ink.toLowerCase() !== o.ink) out.push(`--site-${m}-field:${mixHex(t.surface, t.ink, 0.1)}`);
  return out;
}).join(';');
// botones del hero con color propio (Keystatic → Colores del sitio)
const hb = settings.accent.heroButtons;
const heroBtnVars = hb?.custom ? `--hero-btn-light-bg:${hb.light.bg};--hero-btn-light-ink:${hb.light.ink};--hero-btn-dark-bg:${hb.dark.bg};--hero-btn-dark-ink:${hb.dark.ink}` : '';
// tamaños de texto (Keystatic → Tamaños de texto) y de la barra (Keystatic → Barra de navegación)
const sizes = (settings.type ?? {}) as Record<string, number>;
const FS: Record<string, string> = { text: 'text', headings: 'h', section: 'section', impact: 'impact', work: 'work', project: 'project', facilitation: 'facilitation', experience: 'experience', contact: 'contact', page: 'page', subtitle: 'subtitle', foot: 'foot' };
const navBar = settings.nav?.bar;
const sizeVars = [
  ...Object.entries(FS).filter(([k]) => sizes[k] && sizes[k] !== 1).map(([k, v]) => `--fs-${v}:${sizes[k]}`),
  navBar?.nameScale && navBar.nameScale !== 1 ? `--nav-name-scale:${navBar.nameScale}` : '',
  navBar?.linkSize ? `--nav-link-size:${navBar.linkSize}px` : '',
  navBar?.logoHeight ? `--nav-logo-h:${navBar.logoHeight}px` : '',
].filter(Boolean).join(';');
// sección de contacto: halo siempre; fondo y texto solo si no usa el acento (Keystatic → Efectos)
const fc = settings.look?.finaleColor;
const finaleVars = fc ? [
  `--finale-light-rim-a:${fc.light.rimA};--finale-light-rim-b:${fc.light.rimB};--finale-dark-rim-a:${fc.dark.rimA};--finale-dark-rim-b:${fc.dark.rimB}`,
  fc.mode === 'custom' ? `--finale-light-bg:${fc.light.bg};--finale-light-ink:${fc.light.ink};--finale-dark-bg:${fc.dark.bg};--finale-dark-ink:${fc.dark.ink}` : '',
].filter(Boolean).join(';') : '';
const fonts = fontSetup(settings.fonts);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: settings.name,
  jobTitle: 'Product Designer',
  email: `mailto:${settings.email}`,
  url: new URL(routes.home[lang], site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Oaxaca', addressCountry: 'MX' },
  sameAs: [settings.linkedin],
  knowsLanguage: ['es', 'en'],
};
---
<!doctype html>
<html lang={htmlLang[lang]} style={[accentVars, siteVars, heroBtnVars, finaleVars, sizeVars].filter(Boolean).join(';')} data-hover-fill={settings.look?.hoverFill ?? 'theme'}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={desc}>
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang={htmlLang[lang]} href={canonical}>
  <link rel="alternate" hreflang={htmlLang[other]} href={altHref}>
  <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonical : altHref}>
  <meta name="theme-color" content="#06070b" data-theme-color>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {fonts.builtIn.display && <link rel="preload" href="/fonts/clash-grotesk-500.woff2" as="font" type="font/woff2" crossorigin>}
  {fonts.builtIn.text && <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin>}
  {fonts.preload.map((f) => <link rel="preload" href={f.href} as="font" type={f.type} crossorigin>)}
  {fonts.css && <style is:inline set:html={fonts.css} />}
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={desc}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL(image, site).href}>
  <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'}>
  <meta name="twitter:card" content="summary_large_image">
  <script is:inline>
    document.documentElement.classList.add('js');
    try { const m = localStorage.getItem('mode'); if (m) document.documentElement.dataset.theme = m; } catch (e) {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
</head>
<body>
  <a class="skip" href="#main">{s.ui.skip}</a>
  <Header lang={lang} alternate={alternate} />
  <div class="cursor" aria-hidden="true" data-cursor><span data-cursor-label>{s.ui.view}</span></div>
  <main id="main">
    <slot />
  </main>
  <slot name="after" />
  <LangHint lang={lang} alternate={alternate} />
  <script>
    import '../scripts/sky.js';
    import '../scripts/plus-wave.js';
    import '../scripts/hero-bg.js';
    import '../scripts/lava.js';
    import '../scripts/specular.js';
    import '../scripts/nav-glass.js';
    import '../scripts/scroll-expand.js';
    import '../scripts/app.js';
  </script>
</body>
</html>
