---
import Img from '../components/Img.astro';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Finale from '../components/Finale.astro';
import { t, routes, projectUrl, type Lang } from '../i18n';
import { getBody, type Project } from '../lib/projects';
interface Props { lang: Lang; project: Project; next?: Project }
const { lang, project: p, next } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const s = t(lang).projects;
const body = await getBody(p.slug, lang);
const { Content } = body ? await render(body) : { Content: null };
const facts = [
  [s.facts.role, p.role], [s.facts.team, p.team], [s.facts.duration, p.duration],
  [s.facts.platforms, p.platforms], [s.facts.tools, p.tools], [s.facts.client, p.client],
].filter(([, v]) => v);
---
<Base lang={lang} alternate={projectUrl(other, p.slug)} title={p.title} description={p.summary} image={p.cover || undefined}>
  <article>
    <header class="case-hero">
      <nav class="case-hero__crumbs" aria-label={lang === 'es' ? 'Ruta' : 'Breadcrumb'}><a class="link-plain" href={routes.projects[lang]}>{s.back}</a> <span aria-hidden="true">·</span> {p.discipline} · {p.year}</nav>
      <div class="case-hero__grid">
        <h1 class="case-hero__title">{p.title}</h1>
        <p class="case-hero__summary" data-reveal>{p.summary}</p>
      </div>
    </header>
    {p.cover && <figure class="case-cover"><Img src={p.cover} alt={p.coverAlt} sizes="100vw" loading="eager" fetchpriority="high" /></figure>}
    <dl class="case-facts" data-reveal>
      {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <div class="prose">
      {Content && <Content />}
    </div>
  </article>
  {next && next.slug !== p.slug && (
    <a class="case-next" data-reveal href={projectUrl(lang, next.slug)}>
      <span class="case-next__title">{next.title}</span>
      <span class="case-next__label">{s.next} →</span>
    </a>
  )}
  <Finale slot="after" lang={lang} />
</Base>
