---
import Img from '../Img.astro';
interface Props { before: string; after: string; beforeLabel?: string; afterLabel?: string; alt: string; caption?: string }
const { before, after, beforeLabel = 'Antes', afterLabel = 'Después', alt, caption } = Astro.props;
---
<figure class="md-compare" data-reveal>
  <div class="compare" data-compare>
    <Img src={before} alt={`${alt}: ${beforeLabel}`} sizes="(max-width: 48em) 100vw, 704px" />
    <Img class="compare__after" src={after} alt={`${alt}: ${afterLabel}`} sizes="(max-width: 48em) 100vw, 704px" />
    <span class="compare__label compare__label--before" aria-hidden="true">{beforeLabel}</span>
    <span class="compare__label compare__label--after" aria-hidden="true">{afterLabel}</span>
    <input type="range" min="0" max="100" value="50" aria-label={`${beforeLabel} / ${afterLabel}`} />
    <span class="compare__handle" aria-hidden="true"><span class="compare__knob">↔</span></span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
