---
import { t, projectUrl, routes, type Lang } from '../../i18n';
import { getProjects } from '../../lib/projects';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).projects;
const items = (await getProjects(lang)).filter((p) => p.featured && p.paneLeft);
---
<section class="work" id="trabajo" aria-labelledby="work-title">
  <h2 id="work-title" class="work__title">{s.title}</h2>
  {items.map((p) => (
    <article class="seam" data-seam>
      <div class="seam__stage">
        <div class="seam__pane seam__pane--l"><img src={p.paneLeft} alt={p.paneLeftAlt} loading="lazy" decoding="async" /></div>
        <div class:list={['seam__pane seam__pane--r', { 'seam__pane--detail': p.paneRightDetail }]}><img src={p.paneRight || p.paneLeft} alt={p.paneRightAlt} loading="lazy" decoding="async" /></div>
        <div class="seam__copy">
          <h3 class="seam__name">{p.title}</h3>
          <div class="seam__foot">
            <p class="seam__meta">{p.discipline} · {p.client} · {p.year}</p>
            <a class="seam__link" href={projectUrl(lang, p.slug)}>{p.kind === 'case' ? s.viewCase : s.viewProject} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </article>
  ))}
  <p class="work__all wrap"><a class="link-plain" href={routes.projects[lang]}>{s.all}</a></p>
</section>
